# Banco de dados (PostgreSQL — Neon ou qualquer Postgres compatível)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Autenticação — access token de vida curta (JWT) + refresh token opaco e
# revogável guardado em banco (ver src/routes/auth.routes.ts).
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"

# E-mail transacional (redefinição de senha). Sem RESEND_API_KEY, o backend
# não falha — só registra o conteúdo do e-mail no log em vez de enviar de
# verdade (modo dev). Gere uma chave grátis em https://resend.com.
RESEND_API_KEY=""
EMAIL_FROM="VIDA+ <onboarding@resend.dev>"

# Assistente de IA (VIDA+). Sem esta chave, a IA responde com mensagens
# educativas pré-definidas em vez de gerar respostas personalizadas.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Servidor
PORT=4000
NODE_ENV="development"
LOG_LEVEL="info"

# Painel administrativo — usuário criado via seed (veja src/seed/seed.ts)
ADMIN_EMAIL="admin@vidaplus.app"
ADMIN_PASSWORD="troque-esta-senha"
