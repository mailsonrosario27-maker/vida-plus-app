{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "API_URL": "https://vida-plus-backend.onrender.com/api"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://vida-plus-backend.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
